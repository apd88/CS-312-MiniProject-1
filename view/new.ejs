    <h1>Create New Post</h1>

    <form action="/posts" method="POST">
               <label>Title:</label>
        <input type="text" name="title">
        <label>Content:</label>
        <textarea name="content" rows="10"></textarea>

        <button type="submit">Create Post</button>
    </form>
    </form>

        <a href="/">Back to Homepage</a>
</body>
